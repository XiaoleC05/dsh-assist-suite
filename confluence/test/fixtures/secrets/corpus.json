{
  "$schema": "confluence.test-fixtures.secrets/v1",
  "description": "Synthetic secret corpus for redaction tests (test fixtures only). Every value is fake: no real credential exists here. Match cases must be redacted; preserve cases document text that must NOT be destroyed. Token strings are split into fragment arrays and joined by the loader (scripts/m0-smoke.mjs `loadSecretCorpus`) so that the committed fixture never contains a full credential-shaped literal.",
  "policy": "confluence.redact/v1",
  "cases": [
    {
      "id": "api-key-sk",
      "kind": "match",
      "label": "sk- API key",
      "inputParts": ["export DEEPSEEK_KEY=sk-abc123", "DEF456ghi789JKL012mno345"],
      "expect": "no-raw-match",
      "rawParts": ["sk-abc123", "DEF456ghi789JKL012mno345"]
    },
    {
      "id": "github-token",
      "kind": "match",
      "label": "GitHub personal access token",
      "inputParts": ["token: gh", "p_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "expect": "no-raw-match",
      "rawParts": ["gh", "p_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
    },
    {
      "id": "aws-access-key",
      "kind": "match",
      "label": "AWS access key id",
      "inputParts": ["AWS_ACCESS_KEY_ID=AK", "IAIOSFODNN7EXAMPLE"],
      "expect": "no-raw-match",
      "rawParts": ["AK", "IAIOSFODNN7EXAMPLE"]
    },
    {
      "id": "slack-token",
      "kind": "match",
      "label": "Slack bot token",
      "inputParts": ["slack: xox", "b-111111111111-222222222222-abcdefghijklmnopqrstuvwx"],
      "expect": "no-raw-match",
      "rawParts": ["xox", "b-111111111111-222222222222-abcdefghijklmnopqrstuvwx"]
    },
    {
      "id": "bearer-token",
      "kind": "match",
      "label": "Bearer header value",
      "inputParts": ["Authorization: Bearer eyJhbGci", "OiJIUzI1NiJ9.eyJzdWIi", "OiJtb2NrIn0.c2lnbmF0dXJl"],
      "expect": "no-raw-match",
      "rawParts": ["eyJhbGci", "OiJIUzI1NiJ9.eyJzdWIi", "OiJtb2NrIn0.c2lnbmF0dXJl"]
    },
    {
      "id": "pem-private-key",
      "kind": "match",
      "label": "PEM private key block",
      "inputParts": ["-----BEGIN PRIVATE", " KEY-----\nMIIBVwIBADANBgkqhkiG9w0BAQEFAASCAT8wggE7AgEAAkEAmockmockmock\n-----END PRIVATE", " KEY-----"],
      "expect": "no-raw-match",
      "rawParts": ["MIIBVwIBADANBgkqhkiG9w0BAQEFAASCAT8wggE7AgEAAkEAmockmockmock"]
    },
    {
      "id": "password-assignment",
      "kind": "match",
      "label": "password= assignment",
      "input": "password=hunter2-mock-value",
      "expect": "no-raw-match",
      "raw": "hunter2-mock-value"
    },
    {
      "id": "connection-string",
      "kind": "match",
      "label": "credentialed connection string",
      "inputParts": ["postgres://e2e_user:", "e2e_password_mock", "@db.example.invalid:5432/app"],
      "expect": "no-raw-match",
      "rawParts": ["e2e_password_mock"]
    },
    {
      "id": "absolute-home-path",
      "kind": "match",
      "label": "absolute home path (privacy)",
      "inputParts": ["opened C:\\Users\\mockuser", "\\.dsh\\storages\\confluence\\v1\\workspaces\\ws_01\\journal.1-deadbeef.v1.jsonl"],
      "expect": "no-raw-match",
      "rawParts": ["C:\\Users\\mockuser"]
    },
    {
      "id": "public-key-preserved",
      "kind": "preserve",
      "label": "public key material is not a secret",
      "input": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA\n-----END PUBLIC KEY-----",
      "expect": "unchanged"
    },
    {
      "id": "empty-assignment-preserved",
      "kind": "preserve",
      "label": "empty password assignment has nothing to redact",
      "input": "password:",
      "expect": "unchanged"
    },
    {
      "id": "ordinary-code-preserved",
      "kind": "preserve",
      "label": "ordinary code is not over-redacted",
      "input": "const tokenCount = tokens.length; const passwordField = form.password;",
      "expect": "unchanged"
    }
  ]
}

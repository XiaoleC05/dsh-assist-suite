{
  "name": "dsh-assist-suite",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "对话助手：一个入口汇总长期记忆（Confluence）、输入增强（pro-prompt）与质量门禁（Crisp，默认关闭），并集成三者各自的页面。一个仓库、一个安装项。",
  "icon": "icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./confluence": "./confluence/index.js",
    "./pro-prompt": "./pro-prompt/index.js",
    "./crisp": "./crisp/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "confluence",
    "pro-prompt",
    "crisp",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
